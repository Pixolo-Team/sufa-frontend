# ======================
# PRIVYR
# ======================
# Astro exposes variables to the browser only when they are prefixed with PUBLIC_
PUBLIC_PRIVYR_API_KEY=

# ======================
# SUPABASE (operations page)
# ======================
# Anon key only - never put the service_role key here, it ships to the browser.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Soft gate only, not real auth - see docs/operations/DATABASE.md.
PUBLIC_STAFF_PIN=