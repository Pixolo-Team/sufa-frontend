# ======================
# ZIZO LEADS API
# ======================
# Astro exposes variables to the browser only when they are prefixed with PUBLIC_.
PUBLIC_LEADS_API_URL=http://localhost:3000

# ======================
# SUPABASE (operations page)
# ======================
# Anon key only - never put the service_role key here, it ships to the browser.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Soft gate only, not real auth - see docs/operations/DATABASE.md.
PUBLIC_STAFF_PIN=

# ======================
# SCORE PREDICTOR (/predictions)
# ======================
# Key from https://dashboard.api-football.com — GW fixtures (Premier League,
# league=39) are fetched via the same-origin proxy (astro.config.mjs /
# vercel.json). Free plan: 100 requests/day.
PUBLIC_API_FOOTBALL_KEY=
