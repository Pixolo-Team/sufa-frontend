---
// ENUMS //
import { Colors, Shapes } from "@/neevo/enums/core.enum";
import { ButtonLevels, ButtonSizes } from "@/neevo/enums/button.enum";

// STYLES //
import styles from "./join-us/join-us.module.scss";

// COMPONENTS //
import Button from "@/neevo/components/button/Button.astro";
---

<section
	class={`${styles.sectionWrapper} flex justify-center align-center`}
	data-join-us-section
>
	{/* Join us image — vertical parallax driven by the section's scroll progress */}
	<div
		class={styles.imageWrapper}
		data-parallax="y"
		data-from="-20%"
		data-to="20%"
		data-parallax-target="[data-join-us-section]"
	>
		<picture>
			<source media="(min-width: 768px)" srcset="/images/join-us-desktop.jpg" />
			<source media="(min-width: 600px)" srcset="/images/join-us-mobile.jpg" />
			<img
				src="/images/join-us-mobile.jpg"
				alt="Developing football skills through structured coaching in Ghatkopar, Mumbai"
				class={styles.image}
				loading="lazy"
				decoding="async"
			/>
		</picture>
	</div>
	<div class={`${styles.contentWrapper} text-center`}>
		{/* Title */}
		<p class={`${styles.title} font-weight-500 fade-in-up`}>
			Join the Academy today and start{" "}
			<span class={styles.inlineImageWrapper}>
				<img src="/images/football.png" alt="football" class={styles.inlineImage} />
			</span>
			your journey towards excellence!
		</p>
		{/* Description */}
		<p class={`${styles.description} fade-in-up`}>
			Click below and register for a free trial session and become a part of our
			community.
		</p>
		{/* Button */}
		<div class="fade-in-up">
			<Button
				text="Book a Free Trial"
				color={Colors.SECONDARY}
				size={ButtonSizes.XLARGE}
				shape={Shapes.ROUNDED}
				level={ButtonLevels.INLINE}
				extraClass="font-weight-600"
				dataAttributes={{ "data-enquiry-trigger": "" }}
			/>
		</div>
	</div>
</section>
