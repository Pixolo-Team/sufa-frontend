---
// STYLES //
import styles from "./coaches/coaches.module.scss";

// COMPONENTS //
import CoachesCard from "@/components/coaches-card/CoachesCard.astro";
import SectionHeader from "@/components/section-header/SectionHeader.astro";
import CustomSliderArrows from "@/components/custom-slick-arrows/CustomSliderArrows.astro";

// Coaches List data
const coachesData = [
	{
		firstName: "Harsh",
		lastName: "Patil",
		description:
			"FIFA Elite Youth GK · AFC GK 'C' · AFC 'C' Diploma. He provides strategic leadership across the club's football programme, overseeing the Senior Team while mentoring the coaching staff to deliver a consistent, player-centred development pathway.",
		designation: "Head Coach & Head of Coaches",
		coachImageSrc: "/images/coaches/hp.jpg",
		socialMedia: { instagram: "https://www.instagram.com/_harshgk/" },
		alt: "Coach Harsh Patil at the best football academy in Ghatkopar",
	},
	{
		firstName: "Vipul",
		lastName: "Shinde",
		description:
			"AFC 'C' Diploma. He brings a modern coaching approach to both the Senior Team and U16s, using his tactical insight, technical knowledge and commitment to continuous learning to develop players on and off the pitch.",
		designation: "Assistant & Youth Coach",
		coachImageSrc: "/images/coaches/vs.jpg",
		alt: "Coach Vipul Shinde at the best football academy in Ghatkopar",
	},
	{
		firstName: "Jaydeep",
		lastName: "Nadkarni",
		description:
			"An energetic grassroots and youth coach who combines excellent communication with a dynamic coaching style to create engaging and impactful learning environments.",
		designation: "Grassroot & Youth Coach",
		coachImageSrc: "/images/coaches/jn.jpg",
		alt: "Coach Jaydeep Nadkarni at the best football academy in Ghatkopar",
	},
	{
		firstName: "Siddharth",
		lastName: "Pisal",
		description:
			"Specialising in grassroots football, he has a keen eye for player development, consistently bringing out the best in every child through thoughtful coaching and individual attention.",
		designation: "Grassroot Coach",
		coachImageSrc: "/images/coaches/sp.jpg",
		alt: "Coach Siddharth Pisal at the best football academy in Ghatkopar",
	},
	{
		firstName: "Shailesh",
		lastName: "Raul",
		description:
			"An emerging grassroots coach, recognised for his keen observation skills and his natural ability to build strong connections with young players, creating a positive environment for learning and development.",
		designation: "Grassroot Coach",
		coachImageSrc: "/images/coaches/sr.jpg",
		alt: "Coach Shailesh Raul at the best football academy in Ghatkopar",
	},
];
---

<section class="section-spacing">
	{/* Section Header */}
	<SectionHeader fadedText="Guruji" highlightedText="Our Coaches" />
	{/* Coaches slider */}
	<div class={`${styles.coachesWrapper} container fade-in-up`}>
		<div class="splide" data-slider="coaches" data-coaches-slider>
			<div class="splide__track">
				<ul class="splide__list">
					{
						coachesData.map((coach) => (
							<li class="splide__slide">
								<div class={styles.cardWrap}>
									<div class={styles.cardWrapInner}>
										<CoachesCard
											firstName={coach.firstName}
											lastName={coach.lastName}
											description={coach.description}
											designation={coach.designation}
											coachImageSrc={coach.coachImageSrc}
											socialMedia={coach.socialMedia}
											altTextForImage={coach.alt}
										/>
									</div>
								</div>
							</li>
						))
					}
				</ul>
			</div>
		</div>
		{/* Custom slider arrows */}
		<div class={styles.customArrows}>
			<CustomSliderArrows sliderName="coaches" />
		</div>
	</div>
</section>

<script>
	import { initCarousel } from "@/scripts/carousel";

	// Mirrors the previous react-slick config: 3 up on desktop, 2 on tablet, 1 on mobile
	initCarousel("[data-coaches-slider]", {
		type: "loop",
		perPage: 3,
		perMove: 1,
		speed: 500,
		autoplay: true,
		interval: 3000,
		arrows: false,
		pagination: false,
		breakpoints: {
			992: { perPage: 2 },
			600: { perPage: 1 },
		},
	});
</script>
