---
// ENUMS //
import { Colors, Shapes } from "@/neevo/enums/core.enum";
import { ButtonLevels, ButtonSizes } from "@/neevo/enums/button.enum";

// STYLES //
import styles from "./banner/banner.module.scss";

// COMPONENTS //
import Button from "@/neevo/components/button/Button.astro";

interface Props {
	bannerTitle: string;
	bannerDescription: string;
}

const { bannerTitle, bannerDescription } = Astro.props;
---

<div
	class={`${styles.bannerWrapper} flex align-center justify-center`}
	data-banner
	data-animate-class={styles.animateBanner}
>
	<div class={styles.imageWrapper}>
		{/* Hero video */}
		<video
			src="/videos/hero-video-compressed.mp4"
			title="Best Football Academy in Ghatkopar, Mumbai"
			autoplay
			muted
			loop
			playsinline
			preload="auto"></video>
		<div class={styles.overlay}></div>
	</div>
	{/* Content Wrapper */}
	<div
		class={`${styles.textContent} flex align-center justify-center flex-column`}
	>
		{/* Banner title */}
		<div class={`${styles.bannerTitleWrap} ${styles.textContentWrap}`}>
			<h1
				class={`${styles.bannerTitle} ${styles.textContentWrapInner} font-weight-700`}
			>
				{bannerTitle}
			</h1>
		</div>
		{/* Banner description */}
		<div class={`${styles.bannerDescriptionWrap} ${styles.textContentWrap}`}>
			<p
				class={`${styles.bannerDescription} ${styles.textContentWrapInner} font-weight-400`}
			>
				{bannerDescription}
			</p>
		</div>
		{/* Free Trial Button */}
		<div class={styles.buttonWrapper}>
			<img
				src="/images/panda.svg"
				alt="Panda"
				class={styles.buttonImage}
				width="84"
				height="80"
			/>
			<Button
				text="Book a FREE TRIAL Now"
				shape={Shapes.ROUNDED}
				size={ButtonSizes.XLARGE}
				color={Colors.SECONDARY}
				level={ButtonLevels.INLINE}
				extraClass="font-weight-600"
				dataAttributes={{ "data-enquiry-trigger": "" }}
			/>
		</div>
	</div>
</div>

<script>
	const banner = document.querySelector<HTMLElement>("[data-banner]");

	// Kick off the entrance animation on the first frame after hydration,
	// matching the `useEffect(() => setAnimateBanner(true), [])` behaviour
	requestAnimationFrame(() => {
		if (banner?.dataset.animateClass) {
			banner.classList.add(banner.dataset.animateClass);
		}
	});
</script>
