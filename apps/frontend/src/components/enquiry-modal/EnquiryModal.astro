---
// STYLES //
import styles from "@/styles/pages/home.module.scss";

// COMPONENTS //
import Icon from "@/neevo/components/Icon.astro";
import EnquiryForm from "@/components/enquiry-form/EnquiryForm";
---

{/* Contact Us popup overlay */}
<div class={styles.overlay} data-enquiry-overlay hidden></div>

{/* Contact Us modal */}
<div class={styles.formModal} data-enquiry-modal data-show-class={styles.showPopup}>
	<div data-enquiry-close>
		<Icon iconName="close" class={styles.closeIcon} mode="filled" />
	</div>
	<h2 class={styles.formTitle}>Book A Trial Now</h2>
	{/*
		Hydrated on idle rather than on visibility: the modal is hidden with a
		transform, so its island reports a zero sized box and `client:visible`
		would never fire.
	*/}
	<EnquiryForm client:idle />
</div>

<script>
	const modal = document.querySelector<HTMLElement>("[data-enquiry-modal]");
	const overlay = document.querySelector<HTMLElement>("[data-enquiry-overlay]");
	const showClass = modal?.dataset.showClass ?? "";

	/** Shows or hides the enquiry modal along with its backdrop */
	const setModalVisibility = (isVisible: boolean) => {
		modal?.classList.toggle(showClass, isVisible);

		if (overlay) overlay.hidden = !isVisible;
	};

	// Every trigger across the page opens the same modal
	document.querySelectorAll("[data-enquiry-trigger]").forEach((trigger) => {
		trigger.addEventListener("click", () => setModalVisibility(true));
	});

	overlay?.addEventListener("click", () => setModalVisibility(false));

	modal
		?.querySelector("[data-enquiry-close]")
		?.addEventListener("click", () => setModalVisibility(false));
</script>
