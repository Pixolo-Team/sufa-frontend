---
// UTILS //
import { applySvgAttributes } from "@/utils/svg.util";

interface Props {
	/** File name (without extension) of an SVG living in `public/images` */
	name: string;
	class?: string;
}

const { name, class: className = "" } = Astro.props;

// Eagerly inline every brand/logo SVG in `public/images` as a raw SVG string
const svgModules = import.meta.glob<string>("../../../public/images/*.svg", {
	query: "?raw",
	import: "default",
	eager: true,
});

const rawSvg = Object.entries(svgModules).find(([path]) =>
	path.endsWith(`/${name}.svg`)
)?.[1];

const svgMarkup = rawSvg
	? applySvgAttributes(rawSvg, { class: className })
	: "";
---

<Fragment set:html={svgMarkup} />
