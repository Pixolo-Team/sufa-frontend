---
// STYLES //
import styles from "./section-header.module.scss";

interface Props {
	fadedText?: string;
	highlightedText: string;
	leftImage?: string;
}

const { fadedText = "", highlightedText = "", leftImage } = Astro.props;
---

<div
	class={`fade-in-up text-center flex align-center justify-center ${styles.wrapper}`}
>
	{/* Image */}
	{
		!!leftImage && (
			<div class={styles.leftImageWrapper}>
				<img
					src={leftImage}
					alt="Section Header Image"
					class={`${styles.image} img-responsive full-width-img`}
					width="100"
					height="100"
					loading="lazy"
					decoding="async"
				/>
			</div>
		)
	}
	<div data-section-header-target>
		{/* Faded text */}
		{
			!!fadedText && (
				<h2
					class={`${styles.fadedText} font-weight-800`}
					data-parallax="scale"
					data-values="2,1.2,1"
					data-parallax-target="[data-section-header-target]"
				>
					{fadedText}
				</h2>
			)
		}
		{/* Highlighted text */}
		<h3 class={`${styles.highlightedText} font-weight-700`}>
			{highlightedText}
		</h3>
	</div>
</div>
