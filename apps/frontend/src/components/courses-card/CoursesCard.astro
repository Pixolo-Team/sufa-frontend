---
// STYLES //
import styles from "./courses-card.module.scss";

// COMPONENTS //
import Icon from "@/neevo/components/Icon.astro";

interface Props {
	wrapperClass?: string;
	courseImageSrc: string;
	courseTitle: string;
	altTextForImage?: string;
}

const {
	wrapperClass = "",
	courseImageSrc = "",
	courseTitle = "",
	altTextForImage = "",
} = Astro.props;
---

{/* Course card and Image */}
<div class={`${styles.contentWrapper} ${wrapperClass}`} data-course-tilt>
	<div>
		{/* Course Image */}
		<div class={styles.imageContainer}>
			<img
				src={courseImageSrc}
				alt={altTextForImage}
				class={`${styles.courseImage} img-responsive`}
				width="640"
				height="360"
				loading="lazy"
				decoding="async"
			/>
		</div>
		<div class={styles.textWrapper}>
			{/* Card title */}
			{
				courseTitle.trim() !== "" && (
					<p class={`${styles.cardText} font-weight-600`}>{courseTitle}</p>
				)
			}
		</div>
		{/* Icon Button */}
		<button
			class={`${styles.linkButton} flex align-center justify-center`}
			data-enquiry-trigger
		>
			{/* Icon */}
			<Icon class={styles.buttonIcon} iconName="link-arrow" mode="filled" />
		</button>
	</div>
</div>
