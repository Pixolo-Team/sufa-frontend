---
interface Props {
	index?: string;
	name: string;
	address: string;
	mapsUrl?: string;
	imageSrc?: string;
	imageAlt?: string;
	wrapperClass?: string;
}

const {
	index = "",
	name = "",
	address = "",
	mapsUrl = "#",
	imageSrc = "",
	imageAlt = "",
	wrapperClass = "",
} = Astro.props;
---

<div class={wrapperClass}>
	<article class:list={["center-card", "fade-in-up", { "has-image": !!imageSrc }]}>
		{
			imageSrc && (
				<div class="center-image-wrap">
					<img
						src={imageSrc}
						alt={imageAlt || name}
						class="center-image img-responsive full-width-img"
						width="640"
						height="360"
						loading="lazy"
						decoding="async"
					/>
				</div>
			)
		}
		{index && <span class="center-index font-weight-800">{index}</span>}
		<div class="center-pin" aria-hidden="true">
			<svg
				width="22"
				height="22"
				viewBox="0 0 24 24"
				fill="none"
				xmlns="http://www.w3.org/2000/svg"
			>
				<path
					d="M12 21.5C12 21.5 5 14.87 5 9.75C5 5.91 8.13 2.75 12 2.75C15.87 2.75 19 5.91 19 9.75C19 14.87 12 21.5 12 21.5Z"
					stroke="currentColor"
					stroke-width="1.8"
					stroke-linejoin="round"></path>
				<circle
					cx="12"
					cy="9.75"
					r="2.6"
					stroke="currentColor"
					stroke-width="1.8"></circle>
			</svg>
		</div>
		<h3 class="center-name font-weight-700">{name}</h3>
		<p class="center-address font-weight-500">{address}</p>
		<div class="center-actions">
			<a
				href={mapsUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="center-link font-weight-600"
			>
				Get Directions
				<svg
					width="14"
					height="14"
					viewBox="0 0 24 24"
					fill="none"
					xmlns="http://www.w3.org/2000/svg"
					aria-hidden="true"
				>
					<path
						d="M7 17L17 7M17 7H8M17 7V16"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
			</a>
			<button
				type="button"
				class="center-trial font-weight-600"
				data-enquiry-trigger=""
			>
				Book Free Trial
			</button>
		</div>
	</article>
</div>

<style>
	.center-card {
		position: relative;
		height: 100%;
		display: flex;
		flex-direction: column;
		background-color: var(--color-background-light-tint);
		border: 1px solid var(--color-brand-neutral-light-500, #e8e8e8);
		border-radius: var(--border-radius-large);
		padding: 28px 24px 24px;
		overflow: hidden;
		transition:
			transform 0.25s ease,
			box-shadow 0.25s ease;
	}
	.center-card::before {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 6px;
		background: var(--card-color, var(--color-brand-primary-regular));
	}
	.center-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 16px 32px rgba(0, 0, 0, 0.1);
	}
	.center-image-wrap {
		overflow: hidden;
		aspect-ratio: 16 / 9;
	}
	.center-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.4s ease;
	}
	.center-card:hover .center-image {
		transform: scale(1.05);
	}
	/* When a photo is present it bleeds to the card edges; the pin
	overlaps the photo's bottom edge and the index sits over the photo. */
	.has-image {
		padding-top: 0;
	}
	.has-image::before {
		z-index: 1;
	}
	.has-image .center-image-wrap {
		margin: 0 -24px 0;
	}
	.has-image .center-index {
		color: #fff;
		opacity: 0.9;
		text-shadow: 0 1px 8px rgba(0, 0, 0, 0.5);
		z-index: 1;
	}
	.has-image .center-pin {
		margin-top: -22px;
		position: relative;
		z-index: 1;
		border: 3px solid var(--color-background-light-tint);
	}
	.center-index {
		position: absolute;
		top: 14px;
		right: 18px;
		font-size: 44px;
		line-height: 1;
		color: var(--color-brand-primary-deep);
		opacity: 0.08;
		pointer-events: none;
	}
	.center-pin {
		width: 44px;
		height: 44px;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		color: var(--color-brand-primary-contrast, #fff);
		background: var(--card-color, var(--color-brand-primary-regular));
		margin-bottom: 16px;
	}
	.center-name {
		color: var(--color-brand-primary-deep);
		font-size: var(--color-brand-font-size-xlarge);
		line-height: 1.25;
		text-transform: capitalize;
	}
	.center-address {
		margin-top: 10px;
		color: var(--color-text-tint);
		font-size: var(--color-brand-font-size-small);
		line-height: 1.6;
		flex: 1;
	}
	.center-actions {
		display: flex;
		align-items: center;
		gap: 12px;
		flex-wrap: wrap;
		margin-top: 20px;
		padding-top: 18px;
		border-top: 1px dashed var(--color-brand-neutral-light-500, #e2e2e2);
	}
	.center-link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: var(--color-brand-font-size-small);
		color: var(--color-brand-primary-deep);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.center-trial {
		margin-left: auto;
		font-family: var(--font-family-secondary);
		font-size: var(--color-brand-font-size-small);
		color: var(--color-brand-primary-contrast, #fff);
		background-color: var(--color-brand-primary-deep);
		border-radius: 999px;
		padding: 10px 18px;
		transition:
			transform 0.2s ease,
			opacity 0.2s ease;
	}
	.center-trial:hover {
		opacity: 0.9;
		transform: scale(1.02);
	}
	@media only screen and (min-width: 992px) {
		.center-name {
			font-size: var(--color-brand-font-size-heading-4);
		}
	}
</style>
