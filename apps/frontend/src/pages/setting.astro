---
// ENUMS //
import {
	ButtonIconPosition,
	ButtonLevels,
	ButtonSizes,
} from "@/neevo/enums/button.enum";
import { Colors, Variants } from "@/neevo/enums/core.enum";

// STYLES //
import styles from "@/styles/pages/setting.module.scss";

// LAYOUTS //
import BaseLayout from "@/layouts/BaseLayout.astro";

// COMPONENTS //
import Button from "@/neevo/components/button/Button.astro";
import Switch from "@/neevo/components/switch/Switch.astro";
---

<BaseLayout title="Settings | Skorost United Football Academy">
	<div class={`container ${styles.settingsContainer}`}>
		{/* Heading */}
		<p class={styles.settingTitle}>Settings</p>
		{/* Subheading */}
		<p class={styles.settingDescription}>Do Account Actions here</p>

		{/* Container for toggle and logout section */}
		<div class={styles.settingListWrapper}>
			{/* Toggle Section */}
			<div class={styles.listElement}>
				<p class={styles.listTitle}>Dark Mode</p>
				{/* Theme Switcher */}
				<div class={styles.themeSwitcherContainer}>
					<Switch dataAttributes={{ "data-theme-switch": "" }} />
				</div>
			</div>

			{/* Logout Section */}
			<div class={styles.listElement}>
				<p class={styles.listTitle}>Logout from here</p>
				{/* Button Component */}
				<Button
					text="Logout"
					leftIcon="logout"
					size={ButtonSizes.SMALL}
					variant={Variants.OUTLINE}
					color={Colors.PRIMARY}
					level={ButtonLevels.INLINE}
					iconPosition={ButtonIconPosition.CENTER}
					dataAttributes={{ "data-logout": "" }}
				/>
			</div>
		</div>
	</div>
</BaseLayout>

<script>
	import { Themes } from "@/neevo/enums/theme.enum";
	import { applyTheme, getStoredTheme } from "@/scripts/theme";

	const themeSwitch = document.querySelector<HTMLButtonElement>(
		"[data-theme-switch]"
	);
	const checkedClass = themeSwitch?.dataset.checkedClass ?? "";

	/** Reflects the given theme on both the document and the switch itself */
	const syncSwitch = (theme: Themes) => {
		applyTheme(theme);

		themeSwitch?.classList.toggle(checkedClass, theme === Themes.DARK);
		themeSwitch?.setAttribute("aria-checked", String(theme === Themes.DARK));
	};

	// Reflect the persisted theme once the switch is in the DOM
	syncSwitch(getStoredTheme());

	themeSwitch?.addEventListener("click", () => {
		syncSwitch(getStoredTheme() === Themes.DARK ? Themes.LIGHT : Themes.DARK);
	});

	document.querySelector("[data-logout]")?.addEventListener("click", () => {
		console.log("clicked");
	});
</script>
