---
// STYLES //
import styles from "@/styles/pages/registration.module.scss";

// LAYOUTS //
import BaseLayout from "@/layouts/BaseLayout.astro";

// COMPONENTS //
import Icon from "@/neevo/components/Icon.astro";

// The task id is only known at request time, so this route is rendered on demand
export const prerender = false;

const { taskId } = Astro.params;
---

<BaseLayout title="Track your Registration | Skorost United Football Academy">
	<section class="section-spacing">
		<div class={`${styles.registrationWrapper} flex justify-center`}>
			<div class={styles.contentBox} data-registration data-task-id={taskId}>
				{/* Header */}
				<div class={`${styles.header} flex flex-column align-center`}>
					{/* Logo */}
					<div class={`${styles.logoWrapper} flex align-center justify-center`}>
						<img
							src="/images/skorost.svg"
							alt="Skorost"
							width="120"
							height="40"
							class={styles.logo}
						/>
					</div>
					{/* Subtitle */}
					<h2 class={`${styles.subtitle} font-weight-500`}>Begin your journey</h2>
				</div>

				<div class={styles.content}>
					{/* Profile Section */}
					<div class={styles.profileSection}>
						{/* Student Image */}
						<div class={styles.imageWrapper}>
							<img
								alt="Student Image"
								style="object-fit: cover; position: absolute; height: 100%; width: 100%; inset: 0;"
								data-student-image
								hidden
							/>
						</div>
						{/* Profile Information */}
						<div class={styles.profileInfo}>
							{/* Student Name */}
							<h3 class={`${styles.name} font-weight-700`} data-student-name></h3>
							{/* Age and Batch */}
							<div class={styles.details}>
								<p>
									Age: <span class="font-weight-700" data-student-age></span>
								</p>
								<p>
									Batch: <span class="font-weight-700">U-11</span>
								</p>
							</div>
							{/* Location */}
							<p class={styles.details}>
								Location:
								<span class="font-weight-700">Ghatkopar East</span>
							</p>
						</div>
					</div>

					{/* Status Box */}
					<div class={styles.statusBox}>
						<h4 class={`${styles.statusTitle} font-weight-600`}>TL;DR</h4>
						<p class={`${styles.statusText} font-weight-500`} data-status-comments>
						</p>
					</div>

					{/* Journey List */}
					<div class={styles.journeyList} data-journey-list></div>

					{/* Contact Information */}
					<div class={styles.contactInfo}>
						<p class={styles.contactText}>
							<span class="font-weight-700">Any Questions ?</span> Talk to your
							assigned coordinator
						</p>
						{/* Creator Details */}
						<p class={styles.contactNumber}>
							<span class="font-weight-700" data-creator-username></span>
							<span data-creator-email></span>
						</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	{/* Class names for the journey items, handed to the client script */}
	<template
		data-journey-classes={JSON.stringify({
			journeyItem: styles.journeyItem,
			completedIcon: styles.completedIcon,
			pendingIcon: styles.pendingIcon,
			tickIcon: styles.tickIcon,
			itemContent: styles.itemContent,
			itemTitle: styles.itemTitle,
			itemDate: styles.itemDate,
		})}></template>

	{/* Tick icon markup cloned for each completed step */}
	<template data-tick-template>
		<Icon iconName="tick" class={styles.tickIcon} mode="filled" />
	</template>
</BaseLayout>

<script>
	// TYPES //
	import type { TaskData } from "@/types/registration";

	// ENUMS //
	import { ToastTypes } from "@/neevo/enums/toast.enum";

	// API SERVICES //
	import { getRegistrationStatusRequest } from "@/services/api/registration-status.api.service";

	// SERVICES //
	import { showToast } from "@/neevo/services/toast.service";

	// UTILS //
	import { formatDate } from "@/utils/date.util";

	const container = document.querySelector<HTMLElement>("[data-registration]");
	const taskId = container?.dataset.taskId ?? "";

	const journeyClasses: Record<string, string> = JSON.parse(
		document.querySelector<HTMLElement>("[data-journey-classes]")?.dataset
			.journeyClasses ?? "{}"
	);
	const tickTemplate = document.querySelector<HTMLTemplateElement>(
		"[data-tick-template]"
	);

	/** Writes a value into the element matching the given selector */
	const setText = (selector: string, value: string) => {
		const element = document.querySelector<HTMLElement>(selector);
		if (element) element.textContent = value;
	};

	/** Renders one row per subtask into the journey list */
	const renderJourneyList = (subtasks: TaskData[]) => {
		const list = document.querySelector<HTMLElement>("[data-journey-list]");
		if (!list) return;

		list.replaceChildren();

		subtasks.forEach((subtask) => {
			const isDone = subtask.status === "done";

			const item = document.createElement("div");
			item.className = journeyClasses.journeyItem;

			// Status Icon
			const statusIcon = document.createElement("div");
			statusIcon.className = `${
				isDone ? journeyClasses.completedIcon : journeyClasses.pendingIcon
			} flex align-center justify-center`;

			if (isDone && tickTemplate) {
				statusIcon.append(tickTemplate.content.cloneNode(true));
			}

			// Subtask Content
			const content = document.createElement("div");
			content.className = journeyClasses.itemContent;

			const title = document.createElement("p");
			title.className = `${journeyClasses.itemTitle} font-weight-500`;
			title.textContent = subtask.name;

			const date = document.createElement("p");
			date.className = journeyClasses.itemDate;
			if (isDone) date.textContent = formatDate(subtask.date_updated);

			content.append(title, date);
			item.append(statusIcon, content);
			list.append(item);
		});
	};

	/** Paints the fetched registration data onto the page */
	const renderRegistration = (registration: TaskData) => {
		const studentImage = document.querySelector<HTMLImageElement>(
			"[data-student-image]"
		);

		if (studentImage && registration.description?.student_image) {
			studentImage.src = registration.description.student_image;
			studentImage.hidden = false;
		}

		setText("[data-student-name]", registration.name ?? "");
		setText("[data-student-age]", registration.description?.age ?? "");
		setText("[data-status-comments]", registration.description?.comments ?? "");
		setText("[data-creator-username]", `${registration.creator?.username}: `);
		setText("[data-creator-email]", registration.creator?.email ?? "");

		renderJourneyList(registration.subtasks ?? []);
	};

	/* Fetches the registration status from the API */
	getRegistrationStatusRequest(taskId)
		.then((response) => {
			if (response.status_code === 200) {
				renderRegistration(response.data);
			} else {
				showToast(response.message, ToastTypes.WARNING);
			}
		})
		.catch(() => {
			// Set the error message in the toast
			showToast("Failed to get Status", ToastTypes.ERROR);
		});
</script>
