---
// ENUMS //
import { Colors, Shapes, Sizes } from "@/neevo/enums/core.enum";

// STYLES //
import styles from "@/neevo/components/switch/switch.module.scss";

// UTILS //
import { capitalizeHyphenated } from "@/neevo/utils/string-parser.util";

interface Props {
	label?: string;
	isChecked?: boolean;
	isDisabled?: boolean;
	color?: Colors;
	size?: Sizes;
	shape?: Shapes;
	/** Rendered as-is on the <button>, used to hook up change handlers from scripts */
	dataAttributes?: Record<string, string>;
}

const {
	label = "",
	isChecked = false,
	isDisabled = false,
	color = Colors.PRIMARY,
	size = Sizes.MEDIUM,
	shape = Shapes.DEFAULT,
	dataAttributes = {},
} = Astro.props;

/** Combine the base classes and make a collection of class. */
const buildSwitchClassName = () => {
	// Create array for Classes
	const classes = [styles.switch];

	// Add color class
	classes.push(styles[capitalizeHyphenated(color)]);

	// Add size and shape class
	if (size && shape) {
		classes.push(
			styles[`${capitalizeHyphenated(size)}${capitalizeHyphenated(shape)}`]
		);
	}

	// Add checked class
	if (isChecked) {
		classes.push(styles.checked);
	}

	// Add disabled class
	if (isDisabled) {
		classes.push(styles.disabled);
	}

	return classes.join(" ");
};

const switchClassName = buildSwitchClassName();
---

<div class={styles.switchContainer}>
	{/* Switch */}
	<button
		type="button"
		aria-checked={isChecked}
		role="switch"
		disabled={isDisabled}
		class={switchClassName}
		data-checked-class={styles.checked}
		{...dataAttributes}
	>
		<span class={styles.switchHandle} aria-hidden="true"></span>
	</button>
	{/* Label */}
	{label && <span class={styles.switchLabel}>{label}</span>}
</div>
