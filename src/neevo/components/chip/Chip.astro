---
// ENUMS //
import { Colors, Shapes, Sizes, Variants } from "@/neevo/enums/core.enum";

// STYLES //
import styles from "@/neevo/components/chip/chip.module.scss";

// COMPONENTS //
import Icon from "@/neevo/components/Icon.astro";

// UTILS //
import { capitalizeHyphenated } from "@/neevo/utils/string-parser.util";

interface Props {
	text: string;
	color?: Colors;
	variant?: Variants;
	size?: Sizes;
	shape?: Shapes;
	leftIcon?: string;
	isEllipses?: boolean;
}

const {
	text,
	color = Colors.PRIMARY,
	variant = Variants.SOLID,
	size = Sizes.MEDIUM,
	shape = Shapes.DEFAULT,
	leftIcon = "",
	isEllipses = false,
} = Astro.props;

/** Combine the base classes and make a collection of class. */
const buildChipClassName = () => {
	// Create array for Classes
	const classes = [];

	// Push the base class in it
	classes.push(styles.neevoChipContainer);

	// Check and Add the color and variant classes
	if (variant && color) {
		classes.push(
			styles[`${capitalizeHyphenated(variant)}${capitalizeHyphenated(color)}`]
		);
	}

	// Check and add the Size/Shape Classes
	if (size && shape) {
		classes.push(
			styles[`${capitalizeHyphenated(size)}${capitalizeHyphenated(shape)}`]
		);
	}

	// Convert the array into Classes Strings (to put in class)
	return classes.join(" ");
};

const chipClassName = buildChipClassName();
---

<div class={chipClassName}>
	<div class={styles.chipWrapper}>
		{/* Left Icon */}
		{leftIcon && <Icon class={styles.chipLeftIcon} iconName={leftIcon} />}

		{/* Text */}
		<p class={`${styles.chipText} ${isEllipses ? styles.chipTextEllipses : ""}`}>
			{text}
		</p>
	</div>
</div>
