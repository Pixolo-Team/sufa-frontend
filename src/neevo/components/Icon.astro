---
// UTILS //
import { applySvgAttributes } from "@/utils/svg.util";

interface Props {
	iconName: string;
	class?: string;
	mode?: "filled" | "outline";
	/** Inline styles applied straight onto the <svg> root */
	style?: string;
}

const {
	iconName,
	class: className = "",
	mode = "outline",
	style = "",
} = Astro.props;

// Eagerly inline every icon in `public/icons` as a raw SVG string
const iconModules = import.meta.glob<string>("../../../public/icons/**/*.svg", {
	query: "?raw",
	import: "default",
	eager: true,
});

// Error code icons are stored under their numeric file name but referenced by a slug
const FILE_NAME_ALIASES: Record<string, string> = {
	"404": "not-found",
	"400": "bad-request",
	"500": "internal-server-error",
};

/** Build a `{ filled: {...}, outline: {...} }` lookup keyed by icon name */
const buildIconMap = () => {
	const iconMap: Record<string, Record<string, string>> = {
		filled: {},
		outline: {},
	};

	for (const [path, rawSvg] of Object.entries(iconModules)) {
		const [, iconMode, fileName] = path.match(/\/icons\/(filled|outline)\/(.+)\.svg$/) ?? [];
		if (!iconMode || !fileName) continue;

		iconMap[iconMode][FILE_NAME_ALIASES[fileName] ?? fileName] = rawSvg;
	}

	return iconMap;
};

const rawIcon = buildIconMap()[mode]?.[iconName];

// Force the class and the viewBox onto the svg root, exactly like the old SVGR setup did
const svgMarkup = rawIcon
	? applySvgAttributes(rawIcon, {
			class: className,
			viewBox: "0 0 20 20",
			style,
		})
	: "";
---

{
	svgMarkup ? (
		<Fragment set:html={svgMarkup} />
	) : (
		<div>Unknown component: {iconName}</div>
	)
}
