---
// ENUMS //
import { Colors, Shapes, Sizes } from "@/neevo/enums/core.enum";

// STYLES //
import styles from "./coaches-card.module.scss";

// COMPONENTS //
import Icon from "@/neevo/components/Icon.astro";
import Chip from "@/neevo/components/chip/Chip.astro";

interface Props {
	firstName: string;
	lastName: string;
	description: string;
	designation: string;
	coachImageSrc: string;
	socialMedia?: {
		instagram?: string;
	};
	altTextForImage?: string;
}

const {
	firstName = "",
	lastName = "",
	description = "",
	designation = "",
	coachImageSrc = "",
	socialMedia = {},
	altTextForImage = "",
} = Astro.props;
---

<div class={styles.cardWrapper}>
	<div class={`${styles.contentWrapper} flex flex-column align-start`}>
		{/* Card title */}
		<div class={styles.titleWrapper}>
			{/* Coach First name */}
			<p class={`${styles.firstName} font-secondary font-weight-600`}>
				{firstName}
			</p>
			{/* Coach Last name */}
			<p class={`${styles.lastName} font-secondary font-weight-800`}>
				{lastName}
			</p>
		</div>
		<div class={styles.imageDesignationWrapper}>
			{/* Image */}
			<div class={styles.imageWrapper}>
				<img
					src={coachImageSrc}
					alt={altTextForImage}
					width="250"
					height="250"
					class="img-responsive full-width-img"
					loading="lazy"
					decoding="async"
				/>
			</div>
			{/* Button with Social Media Icons or Arrow */}
			{
				socialMedia?.instagram && (
					<button class={`${styles.linkButton} flex align-center justify-center`}>
						<a
							class="flex"
							href={socialMedia.instagram}
							target="_blank"
							rel="noopener noreferrer"
						>
							<Icon class={styles.buttonIcon} iconName="instagram" />
						</a>
					</button>
				)
			}
			<div class={`${styles.chipWrapper} font-secondary font-weight-700`}>
				{/* Designation */}
				<Chip
					text={designation}
					color={Colors.PRIMARY}
					shape={Shapes.ROUNDED}
					size={Sizes.LARGE}
				/>
			</div>
		</div>
		<div class="flex justify-center">
			{/* Description */}
			<p class={`${styles.description} font-secondary font-weight-500`}>
				{description}
			</p>
		</div>
	</div>
</div>
