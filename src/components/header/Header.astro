---
// TYPES //
import type { HeaderListData } from "@/types/header";

// STYLES //
import styles from "./header.module.scss";

// COMPONENTS //
import Hamburger from "@/components/hamburger/Hamburger.astro";
import InlineSvg from "@/components/inline-svg/InlineSvg.astro";

// Header items
const headerListItems: HeaderListData[] = [
	{ label: "Courses", id: "courses" },
	{ label: "Contact Us", id: "contact" },
];
---

<header>
	<div class={styles.headerWrap} data-header>
		<div class={`${styles.headerMain} flex justify-between align-center`}>
			{/* Header logo */}
			<a href="/">
				<InlineSvg name="skorost" class={styles.headerLogo} />
			</a>

			{/* Links */}
			<nav class={`${styles.pageLinkWrap} font-weight-500 justify-end`}>
				{
					headerListItems.map((link) => (
						<a href={`#${link.id}`} class={styles.pageLink}>
							{link.label}
						</a>
					))
				}
			</nav>

			{/* Hamburger Menu */}
			<Hamburger />
		</div>
		{/* Menu Dropdown */}
		<div
			class={`font-weight-500 ${styles.headerDropdown}`}
			data-header-dropdown
			data-show-class={styles.showDropdown}
		>
			{
				headerListItems.map((link) => (
					<a href={`#${link.id}`} class={styles.pageLink}>
						{link.label}
					</a>
				))
			}
		</div>
	</div>
</header>

<script>
	const hamburger = document.querySelector<HTMLElement>("[data-hamburger]");
	const dropdown = document.querySelector<HTMLElement>("[data-header-dropdown]");

	const hamburgerOpenClass = hamburger?.dataset.showDropdownClass ?? "";
	const dropdownOpenClass = dropdown?.dataset.showClass ?? "";

	/** Opens or closes the mobile dropdown, keeping the hamburger's state in sync */
	const setDropdownVisibility = (isVisible: boolean) => {
		hamburger?.classList.toggle(hamburgerOpenClass, isVisible);
		dropdown?.classList.toggle(dropdownOpenClass, isVisible);
	};

	hamburger?.addEventListener("click", () => {
		setDropdownVisibility(!dropdown?.classList.contains(dropdownOpenClass));
	});

	// Close the dropdown once a link inside it has been followed
	dropdown?.querySelectorAll("a").forEach((link) => {
		link.addEventListener("click", () => setDropdownVisibility(false));
	});
</script>
