---
// ENUMS //
import { ButtonLevels, ButtonSizes } from "@/neevo/enums/button.enum";
import { Colors, Shapes } from "@/neevo/enums/core.enum";

// STYLES //
import styles from "./get-free-trial/get-free-trial.module.scss";

// COMPONENTS //
import Button from "@/neevo/components/button/Button.astro";
---

<section class="section-spacing">
	<div class="container">
		<div class={`${styles.contentWrapper} flex justify-center align-center`}>
			<div class={styles.textWrapper}>
				{/* Heading */}
				<p class={`${styles.heading} font-weight-700 fade-in-up`}>
					Get a Free Trial
				</p>
				{/* Sub heading */}
				<p class={`${styles.subHeading} font-weight-400 fade-in-up`}>
					Experience our football coaching with a free trial session in Ghatkopar.
					Whether you're new to the game or looking to refine your skills, our expert
					trainers offer personalized attention to help you grow.
				</p>
				{/* Button */}
				<div class="fade-in-up">
					<Button
						text="Book a Free Trial Now"
						level={ButtonLevels.INLINE}
						size={ButtonSizes.XLARGE}
						shape={Shapes.ROUNDED}
						color={Colors.SECONDARY}
						extraClass="font-weight-600"
						dataAttributes={{ "data-enquiry-trigger": "" }}
					/>
				</div>
			</div>
			{/* Image */}
			<div class={`${styles.imageWrapper} fade-in-up`}>
				<img
					src="/images/tiger-cub.png"
					alt="tiger"
					class={`${styles.image} img-responsive full-width-img`}
					loading="lazy"
					decoding="async"
				/>
			</div>
		</div>
	</div>
</section>
